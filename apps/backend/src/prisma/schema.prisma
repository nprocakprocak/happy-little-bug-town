generator client {
  provider = "prisma-client"
  output   = "./prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemType {
  leaf_part
  little_rock
  root
  stick
  brick
  wood
  axe
  hammer_and_chisel
  leaf_rake
  shovel
  knife
  nettle_soup
  grilled_greenflies
  iron_ore
  clay
  glass
  paper
  crucible
  iron_ingot
  roof_tile
  wheelbarrel
  paving_stone
  plank
  hoe
  mushroom
  pasta
  rotten_apple
  stuffed_fly
  seeds
  gravel
  concrete
  steel
  basket
  furniture
  sculpture
  desk
  fountain
  book
  flower
}

enum StructureType {
  hole
  anthill
  termite_mound
  beehive
  beetle_house
  greenfly_house
  workshop
  stonemason
  woodcutter
  kitchen
  tavern
  smelter
  farm
  mushrooms_field
  flowers_field
  composter
  library
  town_hall
}

enum BugType {
  beetle
  ant
  ladybug
  termite
  fly
  spider
  greenfly
  bee
}

model User {
  id         String      @id
  googleSub  String?     @unique
  name       String?
  email      String?     @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  sessions   Session[]
  items      Item[]
  structures Structure[]
  stacks     Stack[]
  bugs       Bug[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Item {
  id           String     @id @default(uuid())
  itemType     ItemType
  x            Int?
  y            Int?
  authorId     String
  stackId      String?
  bugId        String?
  structureId  String?
  parentItemId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  removedAt    DateTime?  @map("removed_at")
  author       User       @relation(fields: [authorId], references: [id])
  stack        Stack?     @relation(fields: [stackId], references: [id])
  bug          Bug?       @relation(fields: [bugId], references: [id])
  structure    Structure? @relation(fields: [structureId], references: [id])
  parentItem   Item?      @relation("ItemCraft", fields: [parentItemId], references: [id])
  items        Item[]     @relation("ItemCraft")
}

model Structure {
  id            String        @id @default(uuid())
  bugs          Bug[]
  items         Item[]
  structureType StructureType
  upgradeLevel  Int           @default(0)
  x             Int
  y             Int
  authorId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  author        User          @relation(fields: [authorId], references: [id])

  @@unique([authorId, structureType])
}

model Stack {
  id        String   @id @default(uuid())
  items     Item[]
  bugs      Bug[]
  itemType  ItemType
  x         Int
  y         Int
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
}

model Bug {
  id          String     @id @default(uuid())
  items       Item[]
  bugType     BugType
  x           Int?
  y           Int?
  authorId    String
  structureId String?
  stackId     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  removedAt   DateTime?  @map("removed_at")
  author      User       @relation(fields: [authorId], references: [id])
  structure   Structure? @relation(fields: [structureId], references: [id])
  stack       Stack?     @relation(fields: [stackId], references: [id])
}
