generator client {
  provider = "prisma-client"
  output   = "./prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemType {
  leaf_part
  little_rock
  root
  stick
}

enum StructureType {
  hole
  beetle_house
  workshop
  stonemason
}

enum BugType {
  beetle
}

enum ToolType {
  leaf_rake
  shovel
  hammer_and_chisel
}

model User {
  id String @id
  name String?
  email String? @unique
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items Item[]
  structures Structure[]
  stacks Stack[]
  bugs Bug[]
  tools Tool[]
}

model Item {
  id String @id @default(uuid())
  itemType ItemType
  x Int?
  y Int?
  authorId String
  stackId String?
  bugId String?
  structureId String?
  toolId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id])
  stack Stack? @relation(fields: [stackId], references: [id])
  bug Bug? @relation(fields: [bugId], references: [id])
  structure Structure? @relation(fields: [structureId], references: [id])
  tool Tool? @relation(fields: [toolId], references: [id])
}

model Structure {
  id String @id @default(uuid())
  bugs Bug[]
  items Item[]
  tools Tool[]
  structureType StructureType
  x Int
  y Int
  span Int
  authorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id])
}

model Stack {
  id String @id @default(uuid())
  items Item[]
  itemType ItemType
  x Int
  y Int
  authorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id])
}

model Bug {
  id String @id @default(uuid())
  items Item[]
  bugType BugType
  x Int?
  y Int?
  authorId String
  structureId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id])
  structure Structure? @relation(fields: [structureId], references: [id])
}

model Tool {
  id String @id @default(uuid())
  items Item[]
  toolType ToolType
  x Int?
  y Int?
  authorId String
  structureId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id])
  structure Structure? @relation(fields: [structureId], references: [id])
}
