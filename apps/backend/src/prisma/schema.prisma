generator client {
  provider = "prisma-client"
  output   = "./prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemType {
  leaf_part
  little_rock
  stick
  beetle
}

enum StructureType {
  hole
}

model User {
  id String @id
  name String?
  email String? @unique
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items Item[]
  structures Structure[]
  stacks Stack[]
}

model Item {
  id String @id @default(uuid())
  itemType ItemType
  x Int?
  y Int?
  authorId String
  stackId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id])
  stack Stack? @relation(fields: [stackId], references: [id])
}

model Structure {
  id String @id @default(uuid())
  structureType StructureType
  x Int
  y Int
  span Int
  authorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id])
}

model Stack {
  id String @id @default(uuid())
  itemType ItemType
  items Item[]
  x Int
  y Int
  authorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id])
}
