{
  "name": "happy-little-park",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace @happy-little-park/backend run dev",
    "dev:frontend": "npm --workspace @happy-little-park/frontend run dev",
    "build:utils": "npm --workspace @happy-little-park/utils run build",
    "build:backend": "npm --workspace @happy-little-park/backend run build",
    "migrate:dev:backend": "npm --workspace @happy-little-park/backend run migrate:dev",
    "migrate": "npm run migrate:dev:backend",
    "build:frontend": "npm --workspace @happy-little-park/frontend run build",
    "build": "npm run build:utils && npm run build:backend && npm run build:frontend",
    "start:backend": "npm --workspace @happy-little-park/backend run start",
    "start:frontend": "npm --workspace @happy-little-park/frontend run start",
    "format:backend": "npm --workspace @happy-little-park/backend run format",
    "format:frontend": "npm --workspace @happy-little-park/frontend run format",
    "format": "npm run format:backend && npm run format:frontend",
    "dev": "npx concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
